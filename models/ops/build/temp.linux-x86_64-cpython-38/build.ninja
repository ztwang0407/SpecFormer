ninja_required_version = 1.3
cxx = /home/ubuntu/anaconda3/envs/cdformer/bin/x86_64-conda-linux-gnu-c++
nvcc = /usr/local/cuda-11.8/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -Wstrict-prototypes -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -pipe -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -pipe -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/ubuntu/anaconda3/envs/cdformer/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/ubuntu/anaconda3/envs/cdformer/include -fPIC -DWITH_CUDA -I/home/ubuntu/CDFormer/models/ops/src -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include/TH -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/ubuntu/anaconda3/envs/cdformer/include/python3.8 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -DWITH_CUDA -I/home/ubuntu/CDFormer/models/ops/src -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include/TH -I/home/ubuntu/anaconda3/envs/cdformer/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/ubuntu/anaconda3/envs/cdformer/include/python3.8 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DCUDA_HAS_FP16=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -ccbin /home/ubuntu/anaconda3/envs/cdformer/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/ubuntu/CDFormer/models/ops/build/temp.linux-x86_64-cpython-38/home/ubuntu/CDFormer/models/ops/src/cpu/ms_deform_attn_cpu.o: compile /home/ubuntu/CDFormer/models/ops/src/cpu/ms_deform_attn_cpu.cpp
build /home/ubuntu/CDFormer/models/ops/build/temp.linux-x86_64-cpython-38/home/ubuntu/CDFormer/models/ops/src/cuda/ms_deform_attn_cuda.o: cuda_compile /home/ubuntu/CDFormer/models/ops/src/cuda/ms_deform_attn_cuda.cu
build /home/ubuntu/CDFormer/models/ops/build/temp.linux-x86_64-cpython-38/home/ubuntu/CDFormer/models/ops/src/vision.o: compile /home/ubuntu/CDFormer/models/ops/src/vision.cpp






